# Radio options added to Sidero's kernel/build/config-arm64 (PRD R1).
# The stacks are modules, so they load after Talos mounts the rpi5-radio
# extension that carries them and their firmware.
CONFIG_RFKILL=m
CONFIG_CFG80211=m
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y
CONFIG_BT=m
CONFIG_BT_LE=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_BCM=y
# Booleans: the serial device bus must be built in to attach the Bluetooth
# chip to its UART.
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
